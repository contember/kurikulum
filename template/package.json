{
  "name": "kurikulum-template",
  "private": true,
  "type": "module",
  "dependencies": {
    "kurikulum": "^0.1.2",
    "preact": "^10.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.0.0",
    "happy-dom": "^20.8.9",
    "jszip": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "build:scorm": "KURIKULUM_TARGET=scorm-1.2 bunx --bun vite build && bun run package",
    "package": "bun node_modules/kurikulum/src/scorm/package.ts dist/scorm-1.2 Course dist/Course.zip"
  }
}
