{
  "name": "kurikulum",
  "private": true,
  "workspaces": ["packages/*", "template"],
  "scripts": {
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@kurikulum/core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/bun": "^1.3.11",
    "dprint": "^0.51.1",
    "happy-dom": "^20.8.9",
    "jszip": "^3.10.1",
    "preact": "^10.0.0",
    "typescript": "^5.8.0"
  }
}
